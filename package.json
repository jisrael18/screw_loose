{
  "name": "screw-loose",
  "version": "0.1.0",
  "description": "An ad-free browser screw-sorting puzzle powered by PlayCanvas",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jisrael18/screw_loose.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/jisrael18/screw_loose/issues"
  },
  "homepage": "https://github.com/jisrael18/screw_loose#readme",
  "dependencies": {
    "playcanvas": "2.22.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "private": true
}
